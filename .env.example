# Copy to .env and fill in. .env is gitignored. Never paste keys into chat.

# --- SEC EDGAR (required for `make ingest`) ---
# SEC fair-access policy requires a descriptive User-Agent with your name and email.
# Example format: "Your Name your.email@example.com"
SEC_USER_AGENT=

# --- Free-tier LLM providers (Phase 3+) ---
GEMINI_API_KEY=
GROQ_API_KEY=

# --- Local LLM (Phase 3+) ---
OLLAMA_API_BASE=http://localhost:11434

# --- Optional, OFF by default. Personal local comparison runs only. ---
# Uses your local Claude login via the Claude Agent SDK. Must never serve other users.
PLEXUS_ENABLE_CLAUDE_SDK=0

# --- LLM cache behaviour ---
# 1 = cache-only: any cache miss raises instead of calling a provider (CI uses this).
PLEXUS_LLM_OFFLINE=0
PLEXUS_LLM_CACHE=data/cache/llm.sqlite

# IMPORTANT: do NOT set ANTHROPIC_API_KEY. Claude Code would bill the API instead of the Pro plan.
